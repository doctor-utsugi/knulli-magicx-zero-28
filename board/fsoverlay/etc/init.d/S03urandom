#!/bin/bash
#
# Preserve random seed across reboot. See urandom(4).
#

case "$1" in
  start)
    if seed="$(/usr/bin/knulli-settings-get -f /boot/knulli-boot.conf randomseed)"
    then
      printf "Restoring random seed: "
      # Credit the saved seed as entropy (RNDADDENTROPY), otherwise the CRNG
      # stays uninitialised for ~20 s and every getrandom() caller blocks boot.
      echo $seed | PYTHONHASHSEED=0 python3 -c '
import fcntl, struct, sys
data = bytes.fromhex(sys.stdin.read().strip())
data += b"\0" * (-len(data) % 4)
with open("/dev/random", "wb") as f:
    fcntl.ioctl(f, 0x40085203, struct.pack("ii", len(data) * 8, len(data)) + data)
' || echo $seed | xxd -r -ps > /dev/urandom
      echo "done."
    fi
    ;;
  stop)
    printf "Saving random seed: "
    mount -o remount,rw /boot
    /usr/bin/knulli-settings-set -f /boot/knulli-boot.conf randomseed `xxd -ps -l 512 -c 512 /dev/urandom`
    mount -o remount,ro /boot
    echo "done."
    ;;
  *)
    echo "usage: $0 {start|stop}"
    ;;
esac
