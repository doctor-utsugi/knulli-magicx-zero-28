#!/bin/sh

# The Powkiddy V90s uses a different set of kernel modules
# If we are booting one up, mount bind its modules over the regular 4.9.191
BOARD=$(cat /boot/boot/knulli.board)
if [ "$BOARD" = "powkiddy-v90s" ] || [ "$BOARD" = "powkiddy-v20" ] ; then
	mount -o bind /lib/modules/4.9.191_v90s /lib/modules/4.9.191
fi

# The GPU driver shows fb0 on load, still uninitialized (white stripes). bootlogo-fb.bmp
# is top-down 640x480 BGRA, so its pixel data fills each of the two fb0 buffers as-is.
if [ -f /boot/bootlogo-fb.bmp ] && [ "$(cat /sys/class/graphics/fb0/bits_per_pixel)" = 32 ] \
   && [ "$(cat /sys/class/graphics/fb0/virtual_size)" = "640,960" ]; then
	{ tail -c 1228800 /boot/bootlogo-fb.bmp; tail -c 1228800 /boot/bootlogo-fb.bmp; } > /dev/fb0
fi

# We need the graphics module in order to use SDL since we are
# using the sdl-compat/SDL2 for rendering
cd /lib/modules/4.9.191
pvrsrvctl --start

# With USB power present the PMIC powers the MagicX back on right after a
# poweroff, so a cold boot on the charger shows the charging screen first.
# A reboot leaves a flag so it boots straight through.
if [ "$BOARD" = "magicx-zero-28" ]; then
    RESTART_FLAG="/boot/restart.flag"
    if [ -f "$RESTART_FLAG" ]; then
        mount -o remount,rw /boot
        rm -f "$RESTART_FLAG"
        sync
        mount -o remount,ro /boot
    else
        /usr/bin/charger
    fi
fi

# Start the progress bar
/usr/bin/progressbar &

# Start all init scripts in /etc/init.d
# executing them in numerical order.
#
for i in /etc/init.d/S??* ; do

    # Ignore dangling symlinks (if any).
    [ ! -f "$i" ] && continue

    # Update status for progress bar
    echo "$i" > /tmp/status.txt

    case "$i" in
        *.sh)
            # Source shell script for speed.
            (
                trap - INT QUIT TSTP
                set start
                . $i
            ) &
            ;;
        *)
            case "$i" in
                *S00bootcustom | *S01dbus | *S02resize | *S04populate | *S05udev | *S06modprobe | *S11share | *S12populateshare) # Don't run these in background
                    $i start
                    ;;
                *)
                    $i start &
                    ;;
            esac
            ;;
    esac

    echo $(date +"%F %T,%3N")": ${i} - started" >> /var/run/boot.log
done

exit 0
