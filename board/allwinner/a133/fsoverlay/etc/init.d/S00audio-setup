#!/bin/sh

BOARD=$(cat /boot/boot/knulli.board)
if [ "$BOARD" != "powkiddy-v90s" ] && [ "$BOARD" != "powkiddy-v20" ] && [ "$BOARD" != "magicx-zero-28" ]; then
    exit 1
fi

case "$1" in
    start)
        state=`switch-state SW_HEADPHONE_INSERT 2>/dev/null`
        echo Audio jack state: $state
        if [ "$state" = "1" ]; then
            knulli-audio set headphone
        else
            knulli-audio set speakers
        fi
        amixer -D hw:audiocodec sset LINEOUT on
        # The MagicX Zero 28 speaker amp hangs off LINEOUT, which boots muted at volume 0
        if [ "$BOARD" = "magicx-zero-28" ]; then
            amixer -D hw:audiocodec sset "LINEOUT volume" 26
        fi
        ;;
    stop)
        # do nothing
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
esac
